{
    "description": "SKLINET Next.js Strapi boilerplate",
    "repository": {
        "type": "git",
        "url": "https://github.com/SKLINET/strapi-boilerplate"
    },
    "license": "MIT",
    "scripts": {
        "build": "env-cmd --silent graphql-codegen --config codegen.yml && npm run relay && NODE_ENV=production next build",
        "build:only": "NODE_ENV=production next build",
        "dev": "next dev --turbopack",
        "generate-models": "node ./scripts/generateModels.js",
        "create-blocks": "node ./scripts/createBlocks.js && npm run relay",
        "graphql-codegen": "env-cmd -f .env graphql-codegen --config codegen.yml",
        "lint": "tsc --noEmit && eslint . --fix",
        "relay": "./node_modules/relay-compiler/cli.js",
        "relay:watch": "./node_modules/relay-compiler/cli.js --watch",
        "start": "NODE_ENV=production next start",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": ">=6.0.0"
    },
    "dependencies": {
        "@cloudinary/url-gen": "^1.21.0",
        "@croct/plug-next": "^0.9.0",
        "@croct/plug-react": "^0.16.0",
        "@elastic/elasticsearch": "^8.10.0",
        "@formatjs/intl-localematcher": "^0.5.2",
        "@hookform/resolvers": "^3.3.2",
        "@next/third-parties": "^16.3.5",
        "@react-google-maps/api": "^2.19.2",
        "axios": "^1.18.0",
        "busboy": "^1.6.0",
        "clsx": "^2.0.0",
        "dayjs": "^1.11.10",
        "graphql": "^16.8.1",
        "html-react-parser": "^5.0.6",
        "http-proxy": "^1.18.1",
        "iron-session": "^8.0.1",
        "negotiator": "^0.6.3",
        "next": "^16.3.5",
        "nextjs-toploader": "^1.6.12",
        "nodemailer": "^9.1.1",
        "nprogress": "^0.2.0",
        "react": "^19.2.3",
        "react-countup": "^6.5.3",
        "react-dom": "^19.2.3",
        "react-hook-form": "^7.48.2",
        "react-relay": "^20.1.1",
        "react-remove-scroll": "^2.6.0",
        "react-responsive-carousel": "^3.2.23",
        "react-scroll-parallax": "^3.4.5",
        "react-share": "^5.0.3",
        "relay-runtime": "^20.1.1",
        "swr": "^2.2.4",
        "uuid": "^11.1.1",
        "yup": "^1.3.2",
        "babel-plugin-react-compiler": "^19.0.0-beta-0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.0.0",
        "@eslint/js": "^9.0.0",
        "@graphql-codegen/cli": "^5.0.0",
        "@graphql-codegen/introspection": "4.0.0",
        "@graphql-codegen/schema-ast": "^4.0.0",
        "@next/bundle-analyzer": "^16.3.5",
        "@storybook/addon-a11y": "^10.5.8",
        "@storybook/addon-docs": "^10.5.8",
        "@storybook/nextjs-vite": "^10.5.8",
        "@svgr/webpack": "^8.1.0",
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.4",
        "@types/busboy": "^1.5.3",
        "@types/http-proxy": "^1.17.9",
        "@types/negotiator": "^0.6.3",
        "@types/node": "^20.9.4",
        "@types/nodemailer": "^7.0.9",
        "@types/nprogress": "^0.2.3",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@types/relay-runtime": "^20.1.1",
        "@types/uuid": "^9.0.7",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-v8": "^4.1.10",
        "dotenv": "^16.3.1",
        "env-cmd": "^10.1.0",
        "eslint": "^9.0.0",
        "eslint-config-next": "^16.3.5",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.1",
        "eslint-plugin-storybook": "^10.5.8",
        "glob": "^10.0.0",
        "jsdom": "^29.1.1",
        "lint-staged": "^15.1.0",
        "postcss": "^8.4.31",
        "prettier": "^3.1.0",
        "relay-compiler": "^20.1.1",
        "sass": "^1.69.5",
        "storybook": "^10.5.8",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.3.2",
        "typescript-eslint": "^8.0.0",
        "vite-plugin-svgr": "^4.5.0",
        "vitest": "^4.1.10"
    },
    "overrides": {
        "@babel/core@7": "7.29.7",
        "@babel/plugin-transform-modules-systemjs@7": "7.29.8",
        "@humanfs/node@0.16": "0.16.8",
        "@opentelemetry/core@2": "2.8.0",
        "brace-expansion@5": "5.0.12",
        "browserslist@4": "4.29.0",
        "flatted@3": "3.4.4",
        "follow-redirects@1": "1.16.0",
        "form-data@4": "4.0.6",
        "immutable@3": "3.8.4",
        "immutable@4": "4.3.9",
        "js-yaml@4": "4.3.2",
        "lodash@4": "4.18.1",
        "minimatch": "10.2.6",
        "picomatch@2": "2.3.2",
        "picomatch@4": "4.0.7",
        "shell-quote@1": "1.10.0",
        "svgo@3": "3.3.5",
        "undici@6": "6.28.1",
        "ws@7": "7.5.13",
        "ws@8": "8.21.3",
        "yaml@2": "2.9.1",
        "image-size": "npm:image-size-next@2.1.1"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "prettier": {
        "semi": true,
        "trailingComma": "all",
        "printWidth": 120,
        "tabWidth": 4,
        "singleQuote": true,
        "endOfLine": "lf"
    }
}
